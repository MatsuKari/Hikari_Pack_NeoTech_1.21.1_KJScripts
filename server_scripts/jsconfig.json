{
    "include": [
    "./**/*.js",
    "./**/*.ts",
    "../../../probe/startup/**/*.d.ts",
    "../../../probe/packages/**/*.d.ts"
    ],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "target": "ES2015",
        "disableSizeLimit": true,
        "noEmit": true,
        "assumeChangesOnlyAffectDirectDependencies": true,
        "rootDir": ".",
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "lib": [
            "ES2015",
            "ES2016.Array.Include",
            "ES2017.Object"
        ],
        "typeRoots": [
            "../../.probe/packages",
            "../../.probe/server"
        ]
    }
}